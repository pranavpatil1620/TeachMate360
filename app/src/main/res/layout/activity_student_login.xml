<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="#EAF6FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👨‍🎓"
        android:textSize="55sp"
        android:layout_marginBottom="15dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Login"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#172B4D" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login to access your academic details"
        android:textSize="14sp"
        android:textColor="#667085"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/etStudentEmail"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Student Email"
        android:inputType="textEmailAddress"
        android:background="@drawable/edittext_background"
        android:padding="15dp"
        android:layout_marginBottom="15dp" />

    <EditText
        android:id="@+id/etStudentPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:background="@drawable/edittext_background"
        android:padding="15dp"
        android:layout_marginBottom="25dp" />

    <Button
        android:id="@+id/btnStudentLogin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="LOGIN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button" />

    <TextView
        android:id="@+id/tvStudentRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New student? Register here"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#3155D9"
        android:layout_marginTop="25dp" />

</LinearLayout>