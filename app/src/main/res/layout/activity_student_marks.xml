<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="45sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Marks"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvOverallPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overall Percentage: 0%"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3155D9"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marks Obtained"
                    android:textSize="14sp"
                    android:textColor="#667085" />

                <TextView
                    android:id="@+id/tvMarksObtained"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Marks"
                    android:textSize="14sp"
                    android:textColor="#667085" />

                <TextView
                    android:id="@+id/tvTotalMarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marks Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvMarksReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading marks..."
            android:textSize="16sp"
            android:textColor="#172B4D"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:lineSpacingExtra="6dp" />

        <Button
            android:id="@+id/btnRefreshMarks"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="REFRESH MARKS"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:layout_marginTop="25dp" />

    </LinearLayout>

</ScrollView>