<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢"
            android:textSize="45sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notice Management"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create and manage important notices"
            android:textSize="15sp"
            android:textColor="#667085"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter Notice Title"
            android:textSize="15sp"
            android:singleLine="true"
            android:padding="15dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etNoticeMessage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:hint="Enter Notice Message"
            android:textSize="15sp"
            android:gravity="top"
            android:padding="15dp"
            android:background="@drawable/edittext_background"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveNotice"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SAVE NOTICE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnViewNotices"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="VIEW SAVED NOTICES"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvNoticeReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#172B4D"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>