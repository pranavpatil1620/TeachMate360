<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨‍🏫"
            android:textSize="50sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvWelcomeTeacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Teacher!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvTeacherEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="teacher@email.com"
            android:textSize="15sp"
            android:textColor="#667085"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp" />


        <!-- Quick Overview -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Overview"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="12dp" />


        <!-- Stats Row 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">


            <!-- Students -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/edittext_background"
                android:layout_marginEnd="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍🎓"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tvTotalStudents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Students"
                    android:textSize="12sp"
                    android:textColor="#667085" />

            </LinearLayout>


            <!-- Attendance -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/edittext_background"
                android:layout_marginStart="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tvTotalAttendance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance"
                    android:textSize="12sp"
                    android:textColor="#667085" />

            </LinearLayout>

        </LinearLayout>


        <!-- Stats Row 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="25dp">


            <!-- Assignments -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/edittext_background"
                android:layout_marginEnd="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tvTotalAssignments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignments"
                    android:textSize="12sp"
                    android:textColor="#667085" />

            </LinearLayout>


            <!-- Notices -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/edittext_background"
                android:layout_marginStart="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📢"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tvTotalNotices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notices"
                    android:textSize="12sp"
                    android:textColor="#667085" />

            </LinearLayout>

        </LinearLayout>


        <!-- Attendance -->

        <LinearLayout
            android:id="@+id/cardAttendance"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="32sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage student attendance"
                    android:textSize="13sp"
                    android:textColor="#667085"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Marks -->

        <LinearLayout
            android:id="@+id/cardMarks"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="📝"
                android:textSize="32sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marks"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter and view student marks"
                    android:textSize="13sp"
                    android:textColor="#667085"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Assignments -->

        <LinearLayout
            android:id="@+id/cardAssignment"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="32sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignments"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create and manage assignments"
                    android:textSize="13sp"
                    android:textColor="#667085"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Notices -->

        <LinearLayout
            android:id="@+id/cardNotices"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="📢"
                android:textSize="32sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notices"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create important notices"
                    android:textSize="13sp"
                    android:textColor="#667085"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Profile -->

        <LinearLayout
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="25dp">

            <TextView
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="32sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#172B4D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View teacher profile"
                    android:textSize="13sp"
                    android:textColor="#667085"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Logout -->

        <Button
            android:id="@+id/btnTeacherLogout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="LOGOUT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>