<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollViewStudent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#EAF6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp"
        android:paddingTop="35dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨‍🎓"
            android:textSize="50sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Registration"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your student account"
            android:textSize="14sp"
            android:textColor="#667085"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp" />

        <EditText
            android:id="@+id/etStudentName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etStudentEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etStudentRollNo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Roll Number"
            android:inputType="text"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etStudentClass"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Class / Division"
            android:inputType="text"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etStudentPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etStudentConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:background="@drawable/edittext_background"
            android:padding="15dp"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/btnStudentRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="REGISTER"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button" />

        <TextView
            android:id="@+id/tvStudentLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already registered? Login here"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3155D9"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>